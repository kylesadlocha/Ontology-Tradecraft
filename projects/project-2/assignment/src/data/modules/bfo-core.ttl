@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Classes

bfo:BFO_0000040 a owl:Class ;
    rdfs:label "material entity"@en ;
    skos:definition "An independent continuant that is spatially extended and can have material parts."@en .

bfo:BFO_0000015 a owl:Class ;
    rdfs:label "process"@en ;
    skos:definition "An occurrent that unfolds through time."@en .

bfo:BFO_0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"@en ;
    skos:definition "A continuant that can depend on different bearers at different times."@en .

bfo:BFO_0000019 a owl:Class ;
    rdfs:label "quality"@en ;
    skos:definition "A specifically dependent continuant that is exhibited by an entity."@en .

# Relations

bfo:BFO_0000178 a owl:ObjectProperty ;
    rdfs:label "has continuant part"@en ;
    skos:definition "Relates a continuant to one of its continuant parts."@en .

bfo:BFO_0000055 a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    skos:definition "Relates a process to a realizable entity that is realized in that process."@en .

bfo:BFO_0000197 a owl:ObjectProperty ;
    rdfs:label "inheres in"@en ;
    skos:definition "Relates a specifically dependent continuant to its bearer."@en .

bfo:BFO_0000196 a owl:ObjectProperty ;
    rdfs:label "bearer of"@en ;
    skos:definition "Relates an entity to a specifically dependent continuant that inheres in it."@en .

bfo:BFO_0000139 a owl:ObjectProperty ;
    rdfs:label "temporal part of"@en ;
    skos:definition "Relates an occurrent to an occurrent of which it is a temporal part."@en .
bfo:BFO_0000055 a owl:ObjectProperty ;
    rdfs:label "realizes"@en ;
    skos:definition "Relates a process to a realizable entity that is realized in that process."@en .